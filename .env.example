# Public browser-safe Supabase configuration.
# These values are bundled into client-side code by Next.js because of the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key.
# Never expose this in client components or browser bundles.
SUPABASE_SERVICE_ROLE_KEY=
